{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "garden-media",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-23",
	"observability": {
		"enabled": true
	},
	"vars": {
		// Extra origins allowed to call the API from a browser (comma-separated).
		// https://*.vercel.app is always allowed; add a custom domain here if the site gets one.
		"ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:5173"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "garden-media",
			"database_id": "ae6cd1c2-6f76-4189-b342-bef8090376d3",
			"migrations_dir": "migrations"
		}
	]
}
